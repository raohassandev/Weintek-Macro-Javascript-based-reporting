{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raohassandev/Weintek-Macro-Javascript-based-reporting/blob/main/schemas/site-profile.schema.json",
  "title": "Portable Industrial Historian Site Profile v1",
  "description": "WEINTEK ONLY; no external computer service, no external SQL server. Offline schema design—not native EBPro import.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "display_name",
    "timezone",
    "collection",
    "storage",
    "devices",
    "reports"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "industry": {
      "type": "string",
      "maxLength": 80
    },
    "timezone": {
      "type": "string",
      "minLength": 3,
      "description": "IANA time zone, e.g. Asia/Karachi"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_interval_seconds",
        "missing_data_policy"
      ],
      "properties": {
        "default_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "missing_data_policy": {
          "enum": [
            "mark_gap",
            "fail_report",
            "explicit_estimation"
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "retention_days"
      ],
      "properties": {
        "mode": {
          "enum": [
            "weintek_native",
            "hmi_local_sql_query"
          ]
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "preferred_export": {
          "type": "array",
          "items": {
            "enum": [
              "screen",
              "csv",
              "xlsx",
              "pdf"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "label",
          "source",
          "metrics"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol"
            ],
            "properties": {
              "protocol": {
                "enum": [
                  "modbus_tcp",
                  "modbus_rtu",
                  "plc_tag",
                  "hmi_local",
                  "opc_ua",
                  "mqtt",
                  "other"
                ]
              },
              "endpoint_alias": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric_id",
                "label",
                "kind",
                "unit",
                "source_tag"
              ],
              "properties": {
                "metric_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,79}$"
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "sample",
                    "counter",
                    "state",
                    "event",
                    "transaction"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "source_tag": {
                  "type": "string",
                  "minLength": 1
                },
                "register_format": {
                  "type": "string",
                  "description": "Hardware-specific representation e.g. float32 ABCD; verify per site"
                },
                "sample_interval_seconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "aggregation": {
                  "enum": [
                    "avg_min_max",
                    "delta_reset_aware",
                    "duration_from_transitions",
                    "event_count",
                    "transaction_sum",
                    "raw_only"
                  ]
                },
                "counter_reset_policy": {
                  "enum": [
                    "detect_reset",
                    "manual_interval",
                    "rollover_configured"
                  ]
                },
                "quality_tag": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_id",
          "metrics",
          "periods"
        ],
        "properties": {
          "report_id": {
            "type": "string",
            "pattern": "^RPT-[0-9]{2}$"
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "periods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "custom",
                "day",
                "week",
                "month",
                "year",
                "shift",
                "batch"
              ]
            },
            "uniqueItems": true
          },
          "output": {
            "type": "array",
            "items": {
              "enum": [
                "screen",
                "csv",
                "xlsx",
                "pdf"
              ]
            },
            "uniqueItems": true
          },
          "enabled": {
            "type": "boolean"
          },
          "formula_ref": {
            "type": "string",
            "description": "Version-controlled reference to verified formula"
          },
          "availability": {
            "enum": [
              "planned",
              "documented",
              "simulator_pass",
              "device_pass",
              "customer_accepted"
            ]
          }
        }
      }
    }
  }
}
